@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

: a schema:CreativeWork ;
    schema:about :articleNotesFraming .

:articleNotesFraming a schema:HowTo ;
    schema:name "Frame single-source-article RDF+HTML collections as notes taken about the article"@en ;
    schema:description "When a kg-generator/rdf-infographic-skill collection is built FROM a single external article (as opposed to an original analysis authored by the operator), frame and describe it as notes taken about that article — not as a standalone publication, a definitive analysis, or the article's own official companion."@en ;
    schema:dateCreated "2026-07-30T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-07-30T00:00:00Z"^^xsd:dateTime ;
    schema:step :step1, :step2, :step3 ;
    rdfs:seeAlso <../preferences.ttl#step-articleNotesFraming> .

:step1 a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Identify when this framing applies"@en ;
    schema:text """Applies whenever the generation prompt names a single external article/post as {page_url} or {post-url} and the task is to produce an RDF+HTML(+MD) collection FROM it — including 'meshup' variants that additionally cross-reference other corpus documents. Does not apply to: an original analysis the operator is authoring from scratch (no single source URL), a comparison piece treating two named sources as co-equal subjects (e.g. a vendor-vs-agent-rdf-memory comparison), or a corpus-wide census/registry document. When in doubt, ask: 'if the source article vanished tomorrow, would this document still make sense as a standalone publication, or is it clearly commentary/extraction from that article?' The latter gets this framing."""@en .

:step2 a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Apply the framing in schema:description, hero copy, and section labeling"@en ;
    schema:text """Stated by Kingsley 2026-07-30 for the Latent Space 'Ontologies Are So Back' collection. Concretely:
  - schema:description on the main schema:Article/schema:CreativeWork should read as notes/commentary ABOUT the source (e.g. 'Notes on X's argument that...') rather than asserting original authorship of the underlying claims.
  - Hero subtitle and intro copy should make clear this is a reading/response/note-taking exercise over the named source, not a rebranded republication of it.
  - Section naming should favor 'What the Article Argues' / 'Key Voices' / 'Meshed With' style labels (already the working pattern) over labels implying this document itself broke the story.
  - Attribution footer must still credit the actual source author prominently — notes-framing does not reduce attribution obligations, it clarifies the derivative relationship."""@en .

:step3 a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Do not let notes-framing lower the harness contract bar"@en ;
    schema:text """Notes-framing is a description/tone choice, not a scope reduction. FAQ ≥10, glossary ≥10, HowTo when procedural, resolver-linked entities at first occurrence, RDF/HTML entity parity, and the full KG Explorer/SPARQL/attribution contract all still apply in full — per full-skills-contract-always-applies.ttl. A 'notes about an article' framing describes the relationship to the source, not a license to under-build the deliverable."""@en .
