@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix onto: <../ontology.ttl#> .

<> a schema:CreativeWork ;
    schema:name "howto/p12-passphrase-uyi-file.ttl"@en ;
    schema:description "How to read the local /tmp/uyi passphrase file for principal YouID PKCS#12 unlock — KEY=VALUE lines; use the value of the first pair, never the whole line."@en ;
    schema:dateCreated "2026-07-30T16:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-07-30T16:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :howto .

:howto a schema:HowTo ;
    schema:name "Read /tmp/uyi for principal PKCS#12 passphrase"@en ;
    schema:description "Procedure for unlocking the principal link-in-bio-credentials-5 cert.p12 when the user points at /tmp/uyi (or an equivalent path they name). File format is KEY=VALUE per line, not bare passwords."@en ;
    schema:step :step-locate, :step-parse, :step-unlock, :step-redact ;
    rdfs:seeAlso <../preferences.ttl#step-p12PassphraseUyiFile>,
        <session-governance.ttl>,
        <verified-identity.ttl> .

:step-locate a schema:HowToStep ;
    schema:position "1"^^xsd:integer ;
    schema:name "Locate the passphrase file the user named (default /tmp/uyi)"@en ;
    schema:text """When the user says the PKCS#12 password is in a file (commonly /tmp/uyi):
1. Confirm the file exists and is readable.
2. Do NOT print, log, or write the passphrase into session memory, transcripts, or chat.
3. If the file is missing, report that clearly and ask the user to recreate it — do not guess."""@en .

:step-parse a schema:HowToStep ;
    schema:position "2"^^xsd:integer ;
    schema:name "Parse KEY=VALUE lines — first pair VALUE is the p12 passphrase"@en ;
    schema:text """FILE FORMAT (learned 2026-07-30 after unlock failure):

- Each non-empty line is a KEY=VALUE pair (exactly one '=' separating key from value).
- The principal cert.p12 passphrase is the VALUE of the FIRST key pair:
    first_line.split('=', 1)[1].strip()
- Do NOT use the whole first line as the passphrase (includes key and '=' → Mac verify error: invalid password).
- Do NOT use the key (left of '=') as the passphrase.
- A second line may hold another KEY=VALUE pair for a different secret; only use it when the user explicitly points at that pair.

PROHIBITED: treating each line as a bare password string; concatenating both lines; logging values."""@en .

:step-unlock a schema:HowToStep ;
    schema:position "3"^^xsd:integer ;
    schema:name "Unlock principal cert.p12 with the first-pair value via openssl passin env"@en ;
    schema:text """Canonical principal p12 (credentials root resolved per verified-identity.ttl):
  {CREDENTIALS_ROOT}/Templates/YouID/link-in-bio-credentials-5/cert.p12

Unlock pattern (passphrase never on argv as cleartext in process lists if avoidable):
  export MTLS_PKCS12_PW="$(python3 -c \"from pathlib import Path; print(Path('/tmp/uyi').read_text().splitlines()[0].split('=',1)[1].strip())\")"
  openssl pkcs12 -in cert.p12 -nodes -passin env:MTLS_PKCS12_PW -out /tmp/client.pem
  unset MTLS_PKCS12_PW

Success signal: MAC verified / exit 0 and non-empty PEM.
Then mTLS: curl --cert client.pem --key client.pem <url>
Delete temporary PEMs after use. Do not use On-Behalf-Of unless identityMode is delegation and the user elicited it."""@en .

:step-redact a schema:HowToStep ;
    schema:position "4"^^xsd:integer ;
    schema:name "Never store the passphrase in RDF memory or reports"@en ;
    schema:text "Record only that the source was /tmp/uyi first KEY=VALUE value and whether unlock succeeded. Never copy the value into preferences.ttl, session TTL, howto files, or chat."@en .
