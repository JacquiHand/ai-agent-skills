@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:HowTo ;
    schema:name "Agent Behavior Guide — Full Procedural Detail"@en ;
    schema:description "Companion detail file for preferences.ttl's :agentBehaviorGuide. Migrated from core.ttl on 2026-07-21 to match the ai-agent-skills repo convention: preferences.ttl holds a one-sentence summary of each rule, this file holds the full explanation. Content is otherwise unchanged from the pre-migration core.ttl version." ;
    schema:dateCreated "2026-07-21T00:00:00Z"^^xsd:dateTime ;
    schema:step :step-outputDirs, :step-entityHyperlinks, :step-footerAttribution,
        :step-agentRdfMemoryRead, :step-agentRdfMemoryWrite, :step-darkModeCSS,
        :step-noProactiveEdits, :step-tokenLogging, :step-whoamiResponse ;
    rdfs:seeAlso <../preferences.ttl#agentBehaviorGuide> .

:step-outputDirs a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Save artifacts to correct subfolders"@en ;
    schema:text "All generated files go to /Users/kidehen/Documents/LLMs/Claude Generated/ with subfolders: RDF/ for .ttl and .jsonld, md/ for .md, webpages/ for .html. Never ask where to save unless the user explicitly overrides."@en .

:step-entityHyperlinks a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Hyperlink all entity text via URIBurner resolver"@en ;
    schema:text "Every entity mention in FAQ answers, glossary terms and definitions, and HowTo step labels and text MUST be hyperlinked to the entity's KG IRI using the resolver pattern: https://linkeddata.uriburner.com/describe/?url={url-encoded-iri}. This applies to nodes AND edge labels in KG Explorer."@en .

:step-footerAttribution a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Use <p> prose format for footer attribution"@en ;
    schema:text "Footer attribution in every HTML infographic must use a <p> element with inline prose — never chip-style <div> elements. All tool names (kg-generator, rdf-infographic-skill, URIBurner, Virtuoso) must be hyperlinked to their canonical homepages, not resolver URLs. Pattern: 'Generated using <a>kg-generator</a>, <a>rdf-infographic-skill</a> via <a>Claude</a>. Linked Data resolved via <a>URIBurner</a> (<a>Virtuoso</a>-backed).'"@en .

:step-agentRdfMemoryRead a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Read agent-rdf-memory/ before any task needing context"@en ;
    schema:text "At the start of any session that involves generating files or continuing prior work, list agent-rdf-memory/, then read core.ttl and index.ttl, then read any relevant sessions/ or projects/ file. Never skip this step."@en .

:step-agentRdfMemoryWrite a schema:HowToStep ;
    schema:position 5 ;
    schema:name "Write RDF memory after every meaningful task"@en ;
    schema:text "After completing any meaningful task, generate valid RDF-Turtle and write to the appropriate file in agent-rdf-memory/: sessions/YYYY-MM-DD-{llm-id}-{agent-env}.ttl for session facts, projects/<name>.ttl for project state, entities/*.ttl for named entities. Update index.ttl to reference new files."@en .

:step-darkModeCSS a schema:HowToStep ;
    schema:position 6 ;
    schema:name "Dark mode must use two separate CSS blocks"@en ;
    schema:text "Dark mode CSS must appear as two entirely separate blocks: (1) html[data-theme='dark'] { ... } for the explicit toggle, (2) @media (prefers-color-scheme: dark) { :root { ... } } for the system preference. Never comma-combine these selectors."@en .

:step-noProactiveEdits a schema:HowToStep ;
    schema:position 7 ;
    schema:name "Never proactively fix or modify documents without approval"@en ;
    schema:text "Do not fix or modify any document the user has not explicitly asked about. If a document appears incorrect, ask for clarification or approval before making any changes. Focus only on the current task unless explicitly directed otherwise."@en .

:step-tokenLogging a schema:HowToStep ;
    schema:position 8 ;
    schema:name "Log token usage in session RDF after each meaningful task"@en ;
    schema:text "After completing any meaningful task, if token usage is known, append a schema:PropertyValue block to the current session TTL recording: inputTokens (integer), outputTokens (integer), totalTokens (integer), and optionally estimatedCostUSD (decimal). Source of truth: (1) for plain conversational tasks — use the figure reported by the /usage command if the user provides it; (2) for Workflow-tool tasks — read budget.spent() at workflow completion and write it automatically. Use the predicate :tokenUsage with a blank node carrying these four properties. Never fabricate token counts — omit the block entirely if the figure is unavailable."@en .

:step-whoamiResponse a schema:HowToStep ;
    schema:position 9 ;
    schema:name "Full whoami / identity response (principal + agent + delegation)"@en ;
    schema:text "When the user asks whoami, who am I, who are you, or any identity/delegation question, return the FULL response from agent-rdf-memory — never a user-only stub. Required sections: (1) PRINCIPAL — name, role, organization, email, canonical NetID/WebID, and all owl:sameAs identities from preferences.ttl/core.ttl; (2) AGENT — live session agent identity (product/model/provider/environment) plus any recorded :agentSession (prov:Agent) in memory, noting differences if the live agent differs from the stored record; (3) DELEGATION — :agentRelationship as prov:Delegation with prov:agent, prov:responsibleAgent (canonical NetID), and that the agent acts on behalf of the principal under core.ttl + preferences.ttl; (4) STANDING CONTRACT — brief list of active agentBehaviorGuide HowTo steps that bind the agent. Presentation: every entity mention MUST use the URIBurner resolver https://linkeddata.uriburner.com/describe/?url={url-encoded-iri} per :step-entityHyperlinks. Do not omit the agent or delegation blocks unless the user explicitly requests a shorter form."@en .
